# Application Configuration
ENV=development
PORT=8080
JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=go_template_db
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=25
POSTGRES_MIN_CONNS=5
POSTGRES_MAX_CONN_LIFETIME=30m
POSTGRES_MAX_CONN_IDLE_TIME=15m

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=5

# Allowed CORS Origins
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3067

# Rate Limiting (requests per second)
RATE_LIMIT_RPS=20

# Graceful Shutdown Timeout
SHUTDOWN_TIMEOUT=10s

# Goose CLI Configuration (for running CLI migrations directly)
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://postgres:CHANGE_ME@localhost:5432/go_template_db?sslmode=disable
