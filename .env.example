# Application Configuration
ENV=development
PORT=8080
JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3067
BACKEND_URL=http://localhost:8080
COOKIE_DOMAIN=localhost
SECURE=false

# Google OAuth Configuration
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=48h

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=cookoff_db

# Optional: override host-published ports for `make docker-up` if 5432/6379
# are already in use on your machine (does not affect in-network hostnames)
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379

# Elasticsearch Logging Configuration
ELASTIC_HOST=localhost
ELASTIC_PORT=9200
ELASTIC_SCHEME=http
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=CHANGE_ME
ELASTIC_INDEX=logs
ELASTIC_MAX_RETRIES=3
ELASTIC_INSECURE=false

# Judge0 (required for Round 2/3 code submissions)
JUDGE0_URI=
# Sent as the X-Auth-Token header; must match AUTHN_TOKEN in judge0.conf.
# Leave blank if the Judge0 instance has authentication disabled.
JUDGE0_AUTH_TOKEN=
# Public URL Judge0 PUTs verdicts back to, e.g. https://api.example.com/judge0callback
CALLBACK_URL=
# Optional shared secret for that callback. When set it is appended to the
# callback URL and required back, so a guessed submission token can't forge a
# verdict. Leave blank to keep the endpoint open.
JUDGE0_CALLBACK_SECRET=

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Goose CLI Configuration (for running CLI migrations directly)
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://postgres:CHANGE_ME@localhost:5432/cookoff_db?sslmode=disable

# Per-user request budget (all routes); Run/Submit have stricter built-in limits.
RATE_LIMIT_MAX=15
RATE_LIMIT_WINDOW=1s
# Concurrent synchronous Judge0 calls (Run / custom input) per API process.
JUDGE0_WAIT_SLOTS=64
# Asynq worker concurrency and Postgres pool size per process.
WORKER_COUNT=10
POSTGRES_MAX_CONNS=20
